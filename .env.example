# atlas-hub-ryan-vo Environment Configuration

# Application Environment
APP_ENV=development
APP_SECRET_KEY=change-in-production-atlas-hub-secret-key-32chars
DATABASE_URL=sqlite:///./atlas_hub.db
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000

# Authentication & Keycloak OIDC Settings
OIDC_ISSUER=http://127.0.0.1:8080/realms/atlas-hub
OIDC_CLIENT_ID=atlas-hub-app
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=atlas-hub-app
OIDC_DISCOVERY_URL=http://127.0.0.1:8080/realms/atlas-hub/.well-known/openid-configuration

# LLM Advisory Service (Optional, Server-Side Only)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
